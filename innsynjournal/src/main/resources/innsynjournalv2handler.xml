<?xml version="1.0" encoding="UTF-8"?>

<jws:handler-chains xmlns:jws="http://java.sun.com/xml/ns/javaee">
	<jws:handler-chain name="HandlerChain">
		<!-- 
			The following handlers only process inbound messages, and thus will be executed in reverse order,
			i.e. the last handler in the chain is executed first and so on.
		 -->
		<jws:handler>
            <jws:handler-class>no.nav.dokarkiv.core.jaxws.MDCInHandler</jws:handler-class>
        </jws:handler>
	</jws:handler-chain>
</jws:handler-chains>