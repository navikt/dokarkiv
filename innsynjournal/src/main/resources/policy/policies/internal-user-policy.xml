<?xml version="1.0" encoding="UTF-8"?>
<Policy xmlns="urn:oasis:names:tc:xacml:2.0:policy:schema:os" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="urn:oasis:names:tc:xacml:2.0:policy:schema:os
      http://docs.oasis-open.org/xacml/access_control-xacml-2.0-policy-schema-os.xsd"

		PolicyId="urn:xacml:2.0:nav:joark:policy:ident-type:internbruker"
		RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">

	<Description>
		Rules that apply to NAV-Resource (InternBruker)
	</Description>
	<Target>
		<Subjects>
			<!-- if user is InternBruker -->
			<Subject>
				<SubjectMatch MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
					<AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">InternBruker</AttributeValue>
					<SubjectAttributeDesignator DataType="http://www.w3.org/2001/XMLSchema#string"
												AttributeId="urn:nav:ikt:tilgangskontroll:xacml:subject:ident-type"/>
				</SubjectMatch>
			</Subject>
		</Subjects>
	</Target>

	<!-- Permit access by default -->
	<Rule RuleId="urn:xacml:2.0:nav:joark:policy:ident-type:internbruker:permit" Effect="Permit"/>
</Policy>
