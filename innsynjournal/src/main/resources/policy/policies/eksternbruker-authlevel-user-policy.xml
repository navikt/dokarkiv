<?xml version="1.0" encoding="UTF-8"?>
<Policy xmlns="urn:oasis:names:tc:xacml:2.0:policy:schema:os" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="urn:oasis:names:tc:xacml:2.0:policy:schema:os
      http://docs.oasis-open.org/xacml/access_control-xacml-2.0-policy-schema-os.xsd"
		PolicyId="urn:xacml:2.0:nav:joark:policy:ident-type:eksternbruker:auth-level:4"
		RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">

	<Description>
		A policy that verifies that EksternBruker has access level 4.
	</Description>
	<Target>
		<Subjects>
			<!-- if user is EksternBruker -->
			<Subject>
				<SubjectMatch MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
					<AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">EksternBruker</AttributeValue>
					<SubjectAttributeDesignator DataType="http://www.w3.org/2001/XMLSchema#string"
												AttributeId="urn:nav:ikt:tilgangskontroll:xacml:subject:ident-type"/>
				</SubjectMatch>
			</Subject>
		</Subjects>
	</Target>

	<Rule RuleId="urn:xacml:2.0:nav:joark:policy:ident-type:eksternbruker:auth-level:4:deny" Effect="Deny">
		<Description>
			Deny access if EksternBruker has access level != 4.
		</Description>
		<Condition>
			<Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
					<Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-is-in">
						<AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">4</AttributeValue>
						<SubjectAttributeDesignator DataType="http://www.w3.org/2001/XMLSchema#string"
													SubjectCategory="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
												AttributeId="urn:nav:ikt:tilgangskontroll:xacml:subject:authentication-level" />
					</Apply>

			</Apply>
		</Condition>
	</Rule>

	<Rule RuleId="urn:xacml:2.0:nav:joark:policy:ident-type:eksternbruker:auth-level:4:permit" Effect="Permit"/>
</Policy>