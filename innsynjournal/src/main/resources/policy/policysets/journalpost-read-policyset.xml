<?xml version="1.0" encoding="UTF-8"?>
<PolicySet xmlns="urn:oasis:names:tc:xacml:2.0:policy:schema:os"
		   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xsi:schemaLocation="urn:oasis:names:tc:xacml:2.0:policy:schema:os
      http://docs.oasis-open.org/xacml/access_control-xacml-2.0-policy-schema-os.xsd"
		   PolicySetId="urn:xacml:2.0:nav:joark:policysetid:3:journalpost:read"
		   PolicyCombiningAlgId="urn:oasis:names:tc:xacml:1.0:policy-combining-algorithm:deny-overrides">
	<Description>
		Policies applicable to read operations on journalpost resources
	</Description>
	<Target>
		<Resources>
			<Resource>
				<ResourceMatch MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
					<AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">journalpost</AttributeValue>
					<ResourceAttributeDesignator DataType="http://www.w3.org/2001/XMLSchema#string"
												 AttributeId="urn:nav:ikt:tilgangskontroll:xacml:joark:resource:resource-target"/>
				</ResourceMatch>
			</Resource>
		</Resources>
		<Actions>
			<Action>
				<ActionMatch MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
					<AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">read</AttributeValue>
					<ActionAttributeDesignator DataType="http://www.w3.org/2001/XMLSchema#string"
											   AttributeId="urn:oasis:names:tc:xacml:1.0:action:action-id"/>
				</ActionMatch>
			</Action>
		</Actions>
	</Target>

	<PolicyIdReference>urn:xacml:2.0:nav:joark:policy:ident-type:internbruker</PolicyIdReference>
</PolicySet>
